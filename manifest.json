{
  "display_information": {
    "name": "CodePulse",
    "description": "Codebase intelligence in your Slack conversations",
    "background_color": "#4A154B"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true
    },
    "slash_commands": [
      {
        "command": "/ask-codebase",
        "description": "Ask a question about your codebase",
        "usage_hint": "[your codebase question]"
      }
    ],
    "bot_user": {
      "display_name": "CodePulse",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "search:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true
    }
  }
}
