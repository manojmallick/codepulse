# Slack credentials
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# SigMap MCP configuration
SIGMAP_MCP_COMMAND=npx
SIGMAP_MCP_ARGS=sigmap,--mcp
SIGMAP_ASK_TOOL=query_context
SIGMAP_ASK_ARG=query

# Directory SigMap should index (where gen-context.js was run)
SIGMAP_PROJECT_ROOT=/Users/manojmallick/Downloads/slack project/codepulse

# Set to true to simulate SigMap responses without running the MCP server
SIGMAP_MOCK=false

# Optional: enable Slack Real-Time Search API to append past workspace discussions
ENABLE_SLACK_SEARCH=false

# Optional: comma-separated list of allowed channels (leave empty for all)
ALLOWED_CHANNELS=
